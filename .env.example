# ===== LLM Provider Configuration =====
# Options: "ollama" (local GPU), "gemini" (cloud API), "transformers" (HuggingFace local)
LLM_PROVIDER=ollama

# Ollama Settings (local or remote server)
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_GPU=1

# Gemini Settings (Cloud API - Fallback option)
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>
GEMINI_MODEL=gemini-2.5-flash

# HuggingFace Transformers Settings (Vietnamese Legal LLM)
HF_MODEL=VLSP2025-LegalSML/qwen3-4b-legal-pretrain
HF_QUANTIZATION=4bit
HF_MAX_NEW_TOKENS=512

# ===== RAG Configuration =====
# Vietnamese Legal Embedding (1024D, primary)
EMBEDDING_MODEL=truro7/vn-law-embedding
USE_VIETNAMESE_TOKENIZER=true
EMBEDDING_DEVICE=cuda
EMBEDDING_NORMALIZE=true

CHROMA_PATH=./data/chroma_db

# Chunking parameters
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Retrieval parameters
TOP_K=10

# ===== Qdrant Configuration =====
# Use server mode for better performance (requires Docker)
QDRANT_USE_SERVER=true
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Qdrant Cloud (set QDRANT_USE_CLOUD=true to use cloud instead of local Docker)
QDRANT_USE_CLOUD=false
QDRANT_CLOUD_URL=https://<YOUR_QDRANT_CLUSTER>.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=<YOUR_QDRANT_API_KEY>

# Collection name on Cloud
QDRANT_LEGAL_COLLECTION=legal_rag_vn
QDRANT_COLLECTION=legal_documents
QDRANT_COLLECTION_BY_MODEL=true

# ===== Reranker Configuration =====
# Cross-Encoder reranking (DISABLED for speed)
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=20

# ===== Performance Optimization =====
# Embedding optimization
EMBEDDING_BATCH_SIZE=8
USE_FP16=true

